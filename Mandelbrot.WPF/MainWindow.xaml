<Window x:Class="Mandelbrot.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mandelbrot.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="4" Background="Black">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="MandelbrotImage" Stretch="None" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="1" Margin="8" VerticalAlignment="Top">
            <TextBlock Text="Mandelbrot" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="WidthText" Width="80" Text="800" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Height:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="HeightText" Width="80" Text="600" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Max iterations:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="IterationsText" Width="80" Text="1000" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Workers (0=auto):" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="WorkersText" Width="80" Text="0" />
            </StackPanel>

            <Button x:Name="RenderButton" Content="Render" Width="120" Click="RenderButton_Click" />

            <Separator Margin="0,12,0,12" />

            <TextBlock Text="Timings" FontWeight="Bold" />
            <TextBlock x:Name="SingleThreadedTiming" Text="Single-threaded: -" Margin="0,4,0,0" />
            <TextBlock x:Name="ParallelTiming" Text="Parallel: -" Margin="0,4,0,0" />
            <TextBlock x:Name="SpeedupText" Text="Speedup: -" Margin="0,8,0,0" />

            <TextBlock x:Name="StatusText" Text="Ready" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
